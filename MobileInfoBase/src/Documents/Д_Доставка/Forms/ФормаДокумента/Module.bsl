&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
//Начало Володин А.А. 27 октября 2024 г.
//Итоговая работа по модулю Мобильная разработка в 1С
	МенеджерЗаписи = РегистрыСведений.Д_ФотоДоставок.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Доставка = Объект.Ссылка;
	
	Если ЭтоАдресВременногоХранилища(ФотографияСсылка) Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ФотографияСсылка);
		
		МенеджерЗаписи.Фотография = Новый ХранилищеЗначения(ДвоичныеДанные); 
		МенеджерЗаписи.Записать();
		
	ИначеЕсли ФотографияСсылка = "" Тогда
		
		МенеджерЗаписи.Фотография = Новый ХранилищеЗначения(Неопределено);
		МенеджерЗаписи.Записать();
		
	КонецЕсли;
//Конец Володин А.А. 29 октября 2024 г.
КонецПроцедуры

#КонецОбласти

