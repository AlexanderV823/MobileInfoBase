&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
// Володин А.А. 
// Задача 2 ДЗ Базовые подсистемы 
// 15 октября 2024 г.	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
// Конец вставки от 15 октября 2024 г.
//Начало Володин А.А. 29 октября 2024 г.
//Итоговая работа по модулю Мобильная разработка в 1С
	ФотографияСсылка = "";
	
	ЗначениеКлюча = Новый Структура;
	ЗначениеКлюча.Вставить("Доставка", Объект.Ссылка);
	
	ЗаписьВРегистр = РегистрыСведений.Д_ФотоДоставок.СоздатьКлючЗаписи(ЗначениеКлюча);
	
	ФотографияСсылка = ПолучитьНавигационнуюСсылку(ЗаписьВРегистр, "Фотография", 0);
//Конец Володин А.А. 29 октября 2024 г.
КонецПроцедуры

